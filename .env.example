# ===========================================
# CodeRabbit AI PR Reviewer - Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# -----------------
# Database Configuration
# -----------------
# SQLite (default for development)
DATABASE_URL=sqlite://./coderabbit.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/coderabbit

# -----------------
# Redis Configuration
# -----------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------
# API Gateway Configuration
# -----------------
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080
RUST_LOG=info,coderabbit=debug

# -----------------
# GitHub Integration
# -----------------
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# -----------------
# GitLab Integration
# -----------------
GITLAB_TOKEN=glpat_your_gitlab_token_here
GITLAB_URL=https://gitlab.com

# -----------------
# Azure DevOps Integration
# -----------------
AZURE_DEVOPS_PAT=your_azure_devops_personal_access_token
AZURE_DEVOPS_ORG=your_organization_name

# -----------------
# Bitbucket Integration
# -----------------
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# -----------------
# AI Model Configuration
# -----------------
# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Cohere
COHERE_API_KEY=your_cohere_api_key_here

# -----------------
# Python Service Configuration
# -----------------
PYTHON_SERVER_HOST=localhost
PYTHON_SERVER_PORT=8000
PYTHON_WORKERS=4

# -----------------
# Vector Database Configuration
# -----------------
LANCEDB_PATH=./data/lancedb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------
# DSPy Configuration
# -----------------
DSPY_CACHE_DIR=./data/dspy_cache
DSPY_LM_PROVIDER=openai
DSPY_COMPILED_MODELS_PATH=./data/dspy_compiled

# -----------------
# Security Configuration
# -----------------
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION_HOURS=24
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# -----------------
# AST-Grep Configuration
# -----------------
ASTGREP_ENABLED=true
ASTGREP_RULES_REPO=https://github.com/coderabbitai/ast-grep-essentials
ASTGREP_RULES_PATH=/tmp/ast-grep-rules
ASTGREP_AUTO_UPDATE=true
ASTGREP_CACHE_TTL=86400
ASTGREP_USE_SANDBOX=true  # Run ast-grep in Docker sandbox (recommended for untrusted code)

# -----------------
# Semgrep Configuration
# -----------------
SEMGREP_ENABLED=false  # Opt-in (slower but more comprehensive than AST-Grep)
SEMGREP_RULESETS=auto  # Options: "auto", "p/security-audit", "p/owasp-top-ten", "p/ci" (comma-separated)
SEMGREP_TIMEOUT=60  # Timeout in seconds
SEMGREP_MAX_FINDINGS_PER_FILE=50  # Limit findings per file
SEMGREP_USE_SANDBOX=true  # Run Semgrep in Docker sandbox (recommended for untrusted code)

# -----------------
# Sandbox Configuration
# -----------------
SANDBOX_EXECUTION_TIMEOUT=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPUS=1.0
SANDBOX_MAX_PROCESSES=50
SANDBOX_DOCKER_IMAGE=coderabbit-sandbox:latest
SANDBOX_MAX_OUTPUT_SIZE_BYTES=10240

# -----------------
# PR Test Runner
# -----------------
ENABLE_PR_TEST_RUNNER=false
PR_TEST_TIMEOUT=300
PR_TEST_MAX_MEMORY_MB=2048
PR_TEST_MAX_CPUS=2.0

# -----------------
# Feature Flags
# -----------------
ENABLE_SECURITY_SCANNING=true
ENABLE_AI_REVIEW=true
ENABLE_VECTOR_SEARCH=true
ENABLE_METRICS=true

# -----------------
# Logging & Monitoring
# -----------------
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
METRICS_PORT=9090

# -----------------
# Development Settings
# -----------------
DEV_MODE=false
SKIP_AUTH=false
MOCK_EXTERNAL_APIS=false
